{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /usr/share/caddy
	encode gzip

	# Public API surface, reached through v2x.tools (same-origin → no CORS).
	# Upstreams use Railway PRIVATE networking (<service>.railway.internal:8080 — the port each app's
	# Tomcat binds). No Host rewrite needed internally (no public edge in the path). If private networking
	# ever breaks, revert to the public URLs: https://v2x-tools-{hub,backend}-production.up.railway.app
	# (with `header_up Host <that-domain>`).
	# Split after the hub detach:
	#   - legacy non-V2X cruft stays on v2x-tools-backend (stats, monitoring)
	#   - everything else (convert/generate/messages/aliases/modules, and /api/contact → Telegram) goes to the hub
	@legacy path /api/access-stats* /api/monitoring*
	handle @legacy {
		reverse_proxy http://v2x-tools-backend.railway.internal:8080 {
			# The upstream sleeps when idle (Railway App Sleeping): the first request gets "connection refused"
			# while it boots (~3 s). Retry dial errors for up to 30 s (the request never reached it: safe for POST).
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	# Identity service (v2x-tools-users): OAuth login dance + me/redeem + JWKS. The JWKS lives at
	# /api/auth/.well-known/jwks.json, covered by /api/auth/*. Must come before the generic /api/* below.
	@auth path /api/auth/*
	handle @auth {
		reverse_proxy http://users.railway.internal:8095 {
			# The upstream sleeps when idle (Railway App Sleeping): the first request gets "connection refused"
			# while it boots (~3 s). Retry dial errors for up to 30 s (the request never reached it: safe for POST).
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	handle /api/* {
		reverse_proxy http://v2x-tools-hub.railway.internal:8080 {
			# The upstream sleeps when idle (Railway App Sleeping): the first request gets "connection refused"
			# while it boots (~3 s). Retry dial errors for up to 30 s (the request never reached it: safe for POST).
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	# Engine (v2x-tools-engine) is internal-only (X-Internal-Token on everything else). Expose ONLY the
	# read-only `GET /engine/loaded` list for the dev console, over the private network (the engine
	# listens on IPv6 since 2026-11-19). Method+path matched so nothing else leaks.
	@engine_loaded {
		method GET
		path /engine/loaded
	}
	handle @engine_loaded {
		reverse_proxy http://v2x-tools-engine.railway.internal:8080 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	# Everything else is the static site (Vite dist). Real files win first, then
	# directory index (so /doc/ → /doc/index.html), then SPA fallback to index.html.
	handle {
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
